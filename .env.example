# --- Telegram Client API (https://my.telegram.org) ---
API_ID=12345678
API_HASH=your_api_hash
TELEGRAM_SESSION=
SESSION_NAME=tg_gifts_analytics

# --- Aiogram bot that posts logs into a group ---
BOT_TOKEN=123456789:AA...
LOG_GROUP_ID=-1001234567890

# --- База (локальный SQLite по умолчанию; для Postgres замените URL) ---
DATABASE_URL=sqlite+aiosqlite:///./data/tg_gifts.db
REDIS_URL=redis://127.0.0.1:6379/0

# --- TON RPC / marketplaces ---
TONCENTER_API_URL=https://toncenter.com/api/v2
TONCENTER_API_KEY=
TONAPI_BASE_URL=https://tonapi.io
TONAPI_KEY=
GETGEMS_API_URL=https://api.getgems.io
GETGEMS_API_KEY=
GETGEMS_GRAPHQL_URL=https://api.getgems.io/graphql
MRKT_API_URL=https://api.tgmrkt.io/api/v1
MRKT_AUTH_TOKEN=
TONNEL_API_URL=https://gifts2.tonnel.network
FRAGMENT_BASE_URL=https://fragment.com
PORTAL_API_URL=https://portal-market.com/api
PORTAL_AUTH_TOKEN=

# --- Filter: newcomers with cheap collectible gifts ---
FLOOR_THRESHOLD_TON=10
MIN_UNIQUE_GIFTS=1
MAX_UNIQUE_GIFTS=2
MAX_ACCOUNT_AGE_DAYS=0
REQUIRE_PREMIUM=
MIN_ACTIVITY_SCORE=0
ALERT_COOLDOWN_HOURS=24

# --- Rate limits / concurrency ---
TELEGRAM_CONCURRENCY=3
MARKET_CONCURRENCY=8
HTTP_TIMEOUT_SEC=25
HTTP_MAX_RETRIES=5
GIFT_PAGE_SIZE=50
MARKET_POLL_SEC=45
SCAN_CHAT_MEMBER_LIMIT=0
SEED_USERNAMES=
SEED_USER_IDS=
SEED_CHATS=

# --- Cache TTL ---
FLOOR_CACHE_TTL_SEC=900
RATE_CACHE_TTL_SEC=300
PROFILE_DEDUP_TTL_SEC=86400
